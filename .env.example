# Glass Home needs no environment variables or secrets to run. The dashboard reads its settings
# from the dashboard's own glasshome: section (entity ids only) over the signed-in Home Assistant connection.
#
# These optional settings are for the development tools only. Copy to .env (ignored by git) if you use them.

# Port for the local preview (tools/preview/serve.mjs also accepts it as the first argument)
GLASSHOME_PREVIEW_PORT=8123

# Extra words for tools/validate.mjs to flag: your surname, street, town, Wi-Fi name and so on,
# separated by commas. Prefer a .glasshome-private-terms.txt file (one per line, also ignored by git).
GLASSHOME_PRIVATE_TERMS=

# Never put a Home Assistant token here for this project: nothing in it uses one.
